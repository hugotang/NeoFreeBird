{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tweak strings",
  "description": "One table per strings file, each holding one entry per key with a value per language. Built into <language>.lproj/<table>.strings inside the tweak bundle as it is staged.",
  "type": "object",
  "required": ["Localizable"],
  "properties": {
    "$schema": { "type": "string" },
    "Localizable": {
      "$ref": "#/$defs/table",
      "description": "Cocoa's default table, and so the tweak's own interface strings. It sets the languages the tweak ships, and a key with no value for one of them falls back to English rather than showing the raw key."
    }
  },
  "additionalProperties": {
    "$ref": "#/$defs/table",
    "description": "A further table, written alongside Localizable as <language>.lproj/<name>.strings. Strictly per-language: it is only built for the languages it has values for, and never falls back."
  },
  "$defs": {
    "value": { "type": "string", "minLength": 1 },
    "table": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/translations" }
    },
    "translations": {
      "description": "One value per language. iOS resolves any BCP 47 designator, so add a language here to ship it.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
